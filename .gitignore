# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
GEP_Template/Binaries/
Plugins/*/Binaries/*

# Configuration files generated by the Editor
GEP_Template/Saved/

# Compiled source files for the engine to use
GEP_Template/Intermediate/
Plugins/*/Intermediate/*

# Cache files for the editor to use
GEP_Template/DerivedDataCache/

# Visual Studio generated files
GEP_Template/.vs/
GEP_Template/.vsconfig
GEP_Template/*.slnx
GEP_Template/*.VC.db
GEP_Template/*.VC.opendb